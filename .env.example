PORT=3000
NODE_ENV=development
ALLOWED_ORIGIN=http://localhost:3001

# ถ้าเว้น DB_PASSWORD ว่างไว้ Docker จะใช้รหัส 1234
DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=movie_api
OMDB_API_KEY=

# จำลองการเกิดข้อผิดพลาดจาก API ภายนอก (สำหรับการทดสอบ)
OMDB_FORCE_FAILURE=false
# จำลองการเกิด Timeout จาก API ภายนอก (สำหรับการทดสอบ)
OMDB_FORCE_TIMEOUT=false
