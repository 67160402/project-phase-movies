PORT=3000
NODE_ENV=development
ALLOWED_ORIGIN=http://localhost:3001

DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=movie_api

OMDB_API_KEY=

// จำลองการเกิดข้อผิดพลาดจาก API ภายนอก (สำหรับการทดสอบ)
